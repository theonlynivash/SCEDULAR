# Address of the API (the backend project), including /api and WITHOUT a trailing slash.
#   local computer:   http://localhost:8090/api          (also the default when this is empty)
#   Vercel (two projects): https://your-scedular-api.vercel.app/api
#   college server behind nginx on the same address: /api
# Vite reads this when the site is BUILT, so change it in Vercel and redeploy.
VITE_API_URL=http://localhost:8090/api
