# Local development uses the JSON database in data/scedular_local_db.json.
USE_LOCAL_DB=true

# PostgreSQL / Neon connection string
DATABASE_URL=postgresql://scedular:scedular@localhost:5432/scedular

# Optional local server port
PORT=8090

# Optional pg connection pool size
PG_POOL_MAX=5

# SCEDULAR AI & GroqCloud LLM API Configuration (Groq API Key starting with gsk_...)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_API_BASE=https://api.groq.com/openai/v1
