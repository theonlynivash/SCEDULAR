# ═══════════════════════════ SCEDULAR backend settings ═══════════════════════════
# Copy this file to .env (never commit .env). On Vercel the same names are entered under
# Project → Settings → Environment Variables. Full guide: ../VERCEL_DEPLOY.md and ../HOSTING_PROMPT.md

# ── Where the data lives ──
# auto (default): on a computer the local file data/scedular_local_db.json is used (DATABASE_URL below is ignored);
#                 on Vercel the PostgreSQL database in DATABASE_URL is used.
# file | postgres: force one of them (a college server with its own PostgreSQL sets STORAGE=postgres).
STORAGE=auto

# PostgreSQL / Neon connection string, e.g. postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Put the link here once; your laptop keeps using the local file, the website uses this.
DATABASE_URL=

# Start a brand-new install with an empty dataset instead of the bundled sample department (first start only).
# SCEDULAR_START_BLANK=true

# ── Server ──
PORT=8090
# Optional pg connection pool size (keep small on serverless)
PG_POOL_MAX=3
# Extra websites allowed to call this API, comma separated (the website's address), e.g. https://scedular.vercel.app,https://scedular.panimalar.in
FRONTEND_ORIGIN=
# Behind your own reverse proxy (nginx) set this to true so sign-in limits see the real visitor address
# TRUST_PROXY=true

# ── Login ──
# First-login password for accounts that have no personal password yet. CHANGE IT in production.
SCEDULAR_MASTER_PASSWORD=SCEDULAR_AIDS

# ── Timetable search ──
# Longest a timetable generation may search, in milliseconds (default 180000 = 3 minutes; 45000 on Vercel).
# SOLVER_TIME_LIMIT_MS=180000

# ── SCEDULAR AI (Groq) ──
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_API_BASE=https://api.groq.com/openai/v1

# ── Email (leave letters, passwords, HOD mail) ──
# A Gmail address and its 16-letter App Password (Google Account → Security → 2-Step Verification → App passwords),
# or your college mail server. Leave empty to switch mail off.
# SMTP_USER=your.address@gmail.com
# SMTP_PASS=your_16_letter_app_password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM="SCEDULAR <your.address@gmail.com>"
