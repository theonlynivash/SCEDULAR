# Postgres connection string (Neon, or any Postgres). Neon example:
# postgres://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Optional: max connections in the pool (default 5 -- keep low for serverless).
PG_POOL_MAX=5

# Optional: local dev server port (default 8090). Not used on Vercel.
PORT=8090
