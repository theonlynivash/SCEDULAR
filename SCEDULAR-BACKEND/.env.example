# Local development uses the JSON database in data/scedular_local_db.json.
USE_LOCAL_DB=true

# Start a brand-new install with an empty dataset instead of the bundled sample department.
# SCEDULAR_START_BLANK=true

# PostgreSQL / Neon connection string
DATABASE_URL=postgresql://scedular:scedular@localhost:5432/scedular

# Optional local server port
PORT=8090

# Optional pg connection pool size
PG_POOL_MAX=5

# SCEDULAR AI & GroqCloud LLM API Configuration (Groq API Key starting with gsk_...)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_API_BASE=https://api.groq.com/openai/v1

# Sending mail from the Teachers page (HOD). Use a Gmail address with an "app password"
# (Google Account -> Security -> 2-Step Verification -> App passwords). Leave empty to disable sending.
# SMTP_USER=your.address@gmail.com
# SMTP_PASS=your_16_letter_app_password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM="SCEDULAR <your.address@gmail.com>"

# ── Vercel ── set these in Project -> Settings -> Environment Variables (see ../VERCEL_DEPLOY.md):
# DATABASE_URL (required), SCEDULAR_MASTER_PASSWORD, SMTP_USER, SMTP_PASS, MAIL_FROM, GROQ_API_KEY, GROQ_MODEL, PG_POOL_MAX=3
# SCEDULAR_MASTER_PASSWORD=choose-a-strong-bootstrap-password
