# ═══════════════════════════════════════════════════════════════════════════════
# SCEDULAR — DUAL DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
#
# AUTO-DETECTION (smart default — you typically don't need to change these):
#   • Running LOCALLY (localhost / `npm run dev`)  → ALWAYS uses the local JSON
#     file `data/scedular_local_db.json`, even if DATABASE_URL is set here.
#     This protects your local work from accidentally touching the cloud DB.
#   • Deployed ONLINE (Vercel / Render / Railway / Fly.io / NODE_ENV=production)
#     with a valid DATABASE_URL → automatically uses PostgreSQL/Neon.
#
# OVERRIDE FLAGS (only if you need them):
#   USE_LOCAL_DB=true       Force local JSON file mode (overrides all detection)
#   FORCE_POSTGRES=true     Force PostgreSQL even on localhost (requires DATABASE_URL)
#                           — useful for testing Neon connectivity locally.
#
# ═══════════════════════════════════════════════════════════════════════════════

# ── Local dev override (safe to keep true — it's the default for localhost anyway) ──
USE_LOCAL_DB=true

# ── Start a brand-new install with an empty dataset instead of the bundled sample department. ──
# SCEDULAR_START_BLANK=true

# ═══════════════════════════════════════════════════════════════════════════════
# POSTGRESQL / NEON CONNECTION
# ═══════════════════════════════════════════════════════════════════════════════
# PASTE YOUR NEON / POSTGRESQL LINK HERE.
#
# NOTE: When running locally with `npm run dev`, this URL is IGNORED by default
#       (see auto-detection above). The app keeps using the local JSON file.
#       This URL only activates when:
#         • you deploy to Vercel/hosting, OR
#         • you set FORCE_POSTGRES=true (for local testing against the cloud DB).
#
# Neon format:  postgresql://user:password@ep-xxxx-xxxx-xxxxx.ap-southeast-1.aws.neon.tech/scedular?sslmode=require
# Local format: postgresql://scedular:scedular@localhost:5432/scedular
DATABASE_URL=postgresql://scedular:scedular@localhost:5432/scedular

# ── Optional local server port ──
PORT=8090

# ── PostgreSQL connection pool size. On Vercel serverless keep this small (3). Locally 5-10 is fine. ──
PG_POOL_MAX=5

# ═══════════════════════════════════════════════════════════════════════════════
# SCEDULAR AI & GroqCloud LLM API Configuration (Groq API Key starting with gsk_...)
# ═══════════════════════════════════════════════════════════════════════════════
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_API_BASE=https://api.groq.com/openai/v1

# ═══════════════════════════════════════════════════════════════════════════════
# EMAIL (SMTP) — HOD sends login credentials & notices via the Teachers page.
# ═══════════════════════════════════════════════════════════════════════════════
# Use a Gmail address with an "app password"
# (Google Account -> Security -> 2-Step Verification -> App passwords).
# Leave empty to disable sending (mail-send buttons stay hidden).
#
# SMTP_USER=your.address@gmail.com
# SMTP_PASS=your_16_letter_app_password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM="SCEDULAR <your.address@gmail.com>"

# ═══════════════════════════════════════════════════════════════════════════════
# DEPLOYMENT (Vercel / Hosting) — set THESE in your host's Environment Variables UI:
# ═══════════════════════════════════════════════════════════════════════════════
#
# REQUIRED:
#   DATABASE_URL                — PostgreSQL / Neon connection string
#   SCEDULAR_MASTER_PASSWORD    — Strong password for the initial super-admin
#                                 (HOD) bootstrap login.  Store securely.
#
# RECOMMENDED:
#   GROQ_API_KEY, GROQ_MODEL    — AI assistant features (preferences chat,
#                                 generation-failure explanations, mail drafting)
#   SMTP_USER, SMTP_PASS, MAIL_FROM — enable sending login credentials to faculty
#   PG_POOL_MAX=3               — keep pool small for serverless cold-starts
#
# DO NOT set on Vercel:
#   USE_LOCAL_DB        — omit (so auto-detection picks postgres mode)
#   PORT                — Vercel provides its own
#
