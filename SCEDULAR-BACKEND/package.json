{
  "name": "scedular-backend",
  "version": "1.0.0",
  "description": "SCEDULAR - deterministic constraint-based college timetable scheduler backend",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsx tests/stage6.test.ts && npx vitest run tests/core_workflow.test.ts tests/rebuild_e2e.test.ts tests/phase1_reconciliation.test.ts tests/phase2_auth.test.ts tests/phase3_faculty_allocation.test.ts tests/phase4_5_hod_review_allocation.test.ts tests/phase5_workload_templates.test.ts tests/hod_assign.test.ts tests/blank_dataset_e2e.test.ts tests/teacher_extras.test.ts && npm run build && node tests/facultyAllocationPolicy.test.mjs",
    "test:phase5": "npx vitest run tests/phase5_workload_templates.test.ts",
    "test:phase4_5": "npx vitest run tests/phase4_5_hod_review_allocation.test.ts",
    "test:phase1": "npx vitest run tests/phase1_reconciliation.test.ts",
    "test:phase2": "npx vitest run tests/phase2_auth.test.ts",
    "test:phase3": "npx vitest run tests/phase3_faculty_allocation.test.ts",
    "test:workflow": "npx vitest run tests/core_workflow.test.ts",
    "test:solver": "tsx tests/stage6.test.ts",
    "test:live": "node scripts/live_smoke.mjs ../SCEDULAR_REAL_DATA_FROM_PDFS_STAGE8.xlsx",
    "preflight": "node scripts/final_preflight.mjs"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.13",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.23.1",
    "@vercel/node": "^3.2.29",
    "pg-mem": "^3.0.14",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
